# ─────────────────────────────────────────────────────────────
# FreelancersBix environment placeholders
# Copy to `.env.local` and fill in real values locally.
# NEVER commit real values — `.env*` is gitignored (see `.env.example`).
# ─────────────────────────────────────────────────────────────

# Public origin used for canonical URLs in metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://freelancersbix.com

# PostgreSQL connection string used by all stores (quotes, contacts,
# career applications, admin sessions).
# Required for POST /api/quote, /api/contact and /api/careers to persist.
# Without it the endpoints report a graceful server error instead of faking
# persistence.
# Provision the schema and apply migrations with:
#   DATABASE_URL=... node scripts/db-create.mjs
#   DATABASE_URL=... node scripts/migrate.mjs
# (or npm run db:create / db:migrate with .env.local present).
# Example (never commit):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/freelancersbix
DATABASE_URL=

# (Optional) Email provider key for new-quote notifications.
# When unset, notifications are skipped intentionally — nothing is faked.
# See lib/notifications/quote-notify.ts.
RESEND_API_KEY=

# Admin credentials are created with `npm run admin:create` (email + password
# passed as CLI flags). The password is stored only as an scrypt hash; it is
# never committed or echoed.